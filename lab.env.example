# lab.env — SINGLE SOURCE OF TRUTH for the lab topology.
# Read by the Vagrantfile AND by talos/cluster-up.sh (no more "keep them aligned by hand").
#
# Copy this template, then edit your topology locally (lab.env is gitignored):
#     cp lab.env.example lab.env
#
# Strict format: one KEY=value assignment per line, no spaces and no `;`.
# A real environment variable still wins (e.g. `WORKERS=6 vagrant up`).

# Talos version: drives the ISO (Vagrant) AND the installer image pinned by
# cluster-up.sh (--install-image). Keep it aligned with your `talosctl` version.
TALOS_VERSION=v1.13.7

# INSTALLER IMAGE CHOICE (system extensions baked in or not):
#   The boot ISO stays the classic one; extensions come from the INSTALLER (--install-image).
#
# LAB DEFAULT = "Longhorn" image (Image Factory): includes iscsi-tools + util-linux-tools,
# required by Longhorn (see _k8s/longhorn/schematic.yaml). The schematic is deterministic
# (same extensions => same ID). Regenerate if needed: see _k8s/longhorn/README.md.
INSTALLER_IMAGE=factory.talos.dev/installer/613e1592b2da41ae5e265e8789429f22e121aab91cb4deb6bc3c0b6262961245:v1.13.7
#
# "Ceph" ALTERNATIVE (Rook-Ceph): NO extension needed — RBD ships in the Talos kernel
# (source: docs.siderolabs.com/kubernetes-guides/csi/ceph-with-rook). Use the CLASSIC
# installer (comment the line above out, or leave it empty):
#   INSTALLER_IMAGE=          # => ghcr.io/siderolabs/installer:${TALOS_VERSION} (classic)
# Ceph prerequisites on the Talos side: dedicated raw disks (no partition) + PodSecurity
# `privileged` on the rook-ceph namespace. (Longhorn = iscsi-tools; Ceph = nothing special.)

# Topology: 1 CP = single node; 3 CP = HA (with a VIP)
CONTROL_PLANES=3
WORKERS=3

# Resources per role (read by the Vagrantfile). A control plane is hungrier
# (etcd + apiserver): 4096 is the repo default, and the real minimum as soon as the
# `_k8s/` addons stack up (observability/ requires it). Below 3072, etcd collapses
# under load — only go lower if you know exactly what you are doing.
# Cost of the default topology: 3x4096 + 3x2048 = 18 GB of RAM, 12 vCPU.
CP_MEM=4096
CP_CPU=2
WK_MEM=2048
WK_CPU=2

# CNI CHOICE — read by talos/cluster-up.sh (which applies the patch) AND by
# _k8s/platform-up.sh (which installs the CNI when Talos does not).
#
#   cilium   LAB DEFAULT. Talos installs nothing; platform-up.sh lays down Cilium plus the
#            LoadBalancer IP pool announced over L2 (ARP). The only "everything on" choice:
#            it is the only one that gives Services an EXTERNAL-IP, hence HTTPS UIs.
#   calico   Talos installs nothing; platform-up.sh lays down Calico (Tigera operator).
#            ⚠️ Calico does NOT announce LoadBalancer Service IPs (BGP only, and there is
#            no peer router on a host-only network) => you also need MetalLB and you must
#            adapt _k8s/envoy-gateway/Envoy-Proxy.yml. See _k8s/calico/README.md.
#   flannel  Talos installs flannel at bootstrap (with the host-only VXLAN fix).
#            The cluster works right away, but there is NO LoadBalancer Service: the
#            _k8s/ layer (Gateway, HTTPS UIs) is unusable.
#   none     Neither Talos nor platform-up.sh installs anything: you lay down your own CNI.
#
# Switching CNI on an existing cluster is NOT supported: `vagrant destroy` first.
CNI=cilium

# Domain of the lab UIs (wildcard TLS + HTTPRoute). This repo is public, so the versioned
# default is neutral. Put YOUR domain here; the *-up.sh scripts substitute it.
LAB_DOMAIN=talos.lab.example.io

# DNS zone hosting LAB_DOMAIN (the ACME ClusterIssuer `dnsZones` selector + the scope of the
# Cloudflare token). Empty => the last two labels of LAB_DOMAIN (e.g. `example.io`).
# Only set it when the zone is not inferred correctly (e.g. `co.uk`).
LAB_DNS_ZONE=

# E-mail of the Let's Encrypt ACME account (expiry notifications). Empty => admin@<zone>.
LAB_ACME_EMAIL=

# ACME issuer: `staging` (default) or `prod`.
#
#   staging  UNTRUSTED certificate (browser warning), quota ~30,000/week.
#            The right default for a lab you destroy and rebuild.
#   prod     publicly trusted certificate, but a LET'S ENCRYPT QUOTA OF 5 CERTIFICATES
#            PER WEEK for a given `*.<LAB_DOMAIN>`.
#
# ⚠️ The wildcard only lives in etcd: every `vagrant destroy` destroys it and the rebuild
#    asks for a fresh one. On `prod`, 5 rebuilds within the week exhaust the quota and the
#    lab ends up with NO TLS until the 168 h window expires (error 429).
LAB_ACME_ISSUER=staging

# Cloudflare API token for cert-manager's DNS-01 (permissions Zone:DNS:Edit +
# Zone:Zone:Read on the zone). Leave it empty here: the real value goes into lab.env
# (gitignored), never into this versioned template.
CLOUDFLARE_API_TOKEN=

# Host-only network
NETWORK=192.168.56

# Host-only IP range reserved for LoadBalancer Services (L2 announcement: Cilium, or
# MetalLB with Calico). Outside of the node range (.10/.20/.30 and .101+).
#
# ⚠️ THE FIRST IP OF THE RANGE IS THE ONE THE ENVOY GATEWAY TAKES: that is the one your
# wildcard `*.<LAB_DOMAIN>` DNS record must point at. See README.md §5.
LB_POOL_START=192.168.56.200
LB_POOL_END=192.168.56.230

# Addressing scheme: CP -> .10/.20/.30; workers -> .101/.102/...
CP_IP_START=10
CP_IP_STEP=10
WK_IP_START=101
WK_IP_STEP=1
