# lab.env — SOURCE UNIQUE de la topologie du lab.
# Lu par le Vagrantfile ET talos/cluster-up.sh (fini le « garder aligné à la main »).
#
# Copie ce modèle puis édite ta topologie en local (lab.env est gitignoré) :
#     cp lab.env.example lab.env
#
# Format strict : une seule affectation KEY=value par ligne, sans espaces ni `;`.
# Une variable d'environnement réelle reste prioritaire (ex. `WORKERS=6 vagrant up`).

# Version Talos : pilote l'ISO (Vagrant) ET l'image d'installeur épinglée par
# cluster-up.sh (--install-image). À garder alignée sur la version de `talosctl`.
TALOS_VERSION=v1.13.7

# CHOIX DE L'IMAGE D'INSTALLEUR (extensions système bakées ou non) :
#   L'ISO de boot reste la classic ; les extensions sont tirées de l'INSTALLEUR (--install-image).
#
# DÉFAUT DU LAB = image « Longhorn » (Image Factory) : inclut iscsi-tools + util-linux-tools,
# requis par Longhorn (cf. _k8s/longhorn/schematic.yaml). Schematic déterministe (mêmes
# extensions => même ID). Régénérer si besoin : voir _k8s/longhorn/README.md.
INSTALLER_IMAGE=factory.talos.dev/installer/613e1592b2da41ae5e265e8789429f22e121aab91cb4deb6bc3c0b6262961245:v1.13.7
#
# ALTERNATIVE « Ceph » (Rook-Ceph) : AUCUNE extension nécessaire — RBD est dans le noyau
# Talos (source : docs.siderolabs.com/kubernetes-guides/csi/ceph-with-rook). Utiliser
# l'installeur CLASSIC (commenter la ligne ci-dessus ou la vider) :
#   INSTALLER_IMAGE=          # => ghcr.io/siderolabs/installer:${TALOS_VERSION} (classic)
# Prérequis Ceph côté Talos : disques bruts dédiés (sans partition) + PodSecurity
# `privileged` sur le ns rook-ceph. (Longhorn = iscsi-tools ; Ceph = rien de spécial.)

# Topologie : 1 CP = single ; 3 CP = HA (avec VIP)
CONTROL_PLANES=3
WORKERS=3

# Ressources par rôle (lues par le Vagrantfile). Un CP est plus gourmand
# (etcd + apiserver) : 3072/3 recommandé dès qu'on empile des add-ons.
CP_MEM=2048
CP_CPU=2
WK_MEM=2048
WK_CPU=2

# CHOIX DU CNI — lu par talos/cluster-up.sh (patch appliqué) ET par _k8s/platform-up.sh
# (qui installe le CNI quand ce n'est pas Talos qui le fait).
#
#   cilium   DÉFAUT du lab. Talos n'installe rien ; platform-up.sh pose Cilium + le pool
#            d'IP LoadBalancer annoncé en L2 (ARP). Seul choix « tout allumé » : c'est le
#            seul qui donne une EXTERNAL-IP aux Services, donc les UI en HTTPS.
#   calico   Talos n'installe rien ; platform-up.sh pose Calico (opérateur Tigera).
#            ⚠️ Calico n'annonce PAS les IP de Service LoadBalancer (BGP uniquement, et il
#            n'y a pas de routeur pair en host-only) => il faut installer MetalLB en plus
#            et adapter _k8s/envoy-gateway/Envoy-Proxy.yml. Voir _k8s/calico/README.md.
#   flannel  Talos installe flannel au bootstrap (avec le correctif VXLAN host-only).
#            Cluster fonctionnel immédiatement, mais AUCUN Service LoadBalancer : la
#            couche _k8s/ (Gateway, UI HTTPS) est inutilisable.
#   none     Talos n'installe rien et platform-up.sh non plus : tu poses ton CNI à la main.
#
# Changer de CNI sur un cluster existant n'est PAS supporté : `vagrant destroy` d'abord.
CNI=cilium

# Domaine des UI du lab (wildcard TLS + HTTPRoute). Le dépôt est public : le défaut
# versionné est neutre. Mets TON domaine ici, il sera substitué par les scripts *-up.sh.
LAB_DOMAIN=talos.lab.example.io

# Zone DNS qui héberge LAB_DOMAIN (selector `dnsZones` du ClusterIssuer ACME + scope du
# token Cloudflare). Vide => les deux derniers labels de LAB_DOMAIN (ex. `example.io`).
# À renseigner seulement si la zone n'est pas déduite correctement (ex. `co.uk`).
LAB_DNS_ZONE=

# E-mail du compte ACME Let's Encrypt (notifications d'expiration). Vide => admin@<zone>.
LAB_ACME_EMAIL=

# Token API Cloudflare pour le DNS-01 de cert-manager (permissions Zone:DNS:Edit +
# Zone:Zone:Read sur la zone). Laisse vide ici : la vraie valeur va dans lab.env
# (gitignoré), jamais dans ce modèle versionné.
CLOUDFLARE_API_TOKEN=

# Réseau host-only
NETWORK=192.168.56

# Plage d'IP host-only réservée aux Services LoadBalancer (annonce L2 : Cilium, ou
# MetalLB avec Calico). Hors de la plage des nodes (.10/.20/.30 et .101+).
#
# ⚠️ LA PREMIÈRE IP DE LA PLAGE EST CELLE QUE PREND LE GATEWAY ENVOY : c'est ELLE que
# doit viser ton enregistrement DNS wildcard `*.<LAB_DOMAIN>`. Voir README.md §5.
LB_POOL_START=192.168.56.200
LB_POOL_END=192.168.56.230

# Schéma d'adressage : CP -> .10/.20/.30 ; workers -> .101/.102/...
CP_IP_START=10
CP_IP_STEP=10
WK_IP_START=101
WK_IP_STEP=1
